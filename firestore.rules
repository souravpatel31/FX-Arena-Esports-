rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.uid == "XoXyXcnrlzOaMIKKolXnU3mT9xn1" ||
        (request.auth.token.email_verified == true && request.auth.token.email is string && (
          request.auth.token.email.lower() == "souravpatel312@gmail.com" ||
          request.auth.token.email.lower() == "qupagaming@gmail.com" ||
          request.auth.token.email.lower() == "mahendrathakur9009@gmail.com" ||
          request.auth.token.email.lower() == "mahendrar9009@gmail.com"
        ))
      );
    }

    function isStaff() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ||
        (request.auth.token.email_verified == true && request.auth.token.email is string && (
          request.auth.token.email.lower() == "adminrushxesports@gmail.com"
        ))
      );
    }

    function isValidStaffResultUserUpdate(existingData, incomingData) {
      return incomingData.diff(existingData).affectedKeys().hasOnly(['wallet', 'stats']) && (
        !incomingData.diff(existingData).affectedKeys().hasAny(['wallet']) || (
          !('wallet' in existingData) ? (
            incomingData.wallet is map &&
            incomingData.wallet.get('deposit', 0) == existingData.get('walletBalance', 0) &&
            incomingData.wallet.get('bonus', 0) == existingData.get('bonus', 0) &&
            incomingData.wallet.get('winnings', 0) is number &&
            incomingData.wallet.get('winnings', 0) >= existingData.get('winnings', 0) &&
            incomingData.wallet.get('winnings', 0) <= existingData.get('winnings', 0) + 50000
          ) : (
            incomingData.wallet is map &&
            incomingData.wallet.get('deposit', 0) == existingData.wallet.get('deposit', 0) &&
            incomingData.wallet.get('bonus', 0) == existingData.wallet.get('bonus', 0) &&
            incomingData.wallet.get('winnings', 0) is number &&
            incomingData.wallet.get('winnings', 0) >= existingData.wallet.get('winnings', 0) &&
            incomingData.wallet.get('winnings', 0) <= existingData.wallet.get('winnings', 0) + 50000
          )
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGameMode(data) {
      return data.keys().hasAll(['id', 'gameId', 'title', 'image']) &&
             data.id is string && data.id.size() <= 100 &&
             data.gameId is string && data.gameId.size() <= 50 &&
             data.title is string && data.title.size() <= 100 &&
             data.image is string && data.image.size() <= 500000;
    }

    function isValidMatchCredential(data) {
      return data.keys().hasAll(['matchId']) &&
             data.keys().hasOnly(['matchId', 'roomId', 'roomPassword', 'roomNotes', 'updatedAt']) &&
             data.matchId is string && isValidId(data.matchId) &&
             (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 100)) &&
             (!('roomPassword' in data) || (data.roomPassword is string && data.roomPassword.size() <= 100)) &&
             (!('roomNotes' in data) || (data.roomNotes is string && data.roomNotes.size() <= 500));
    }

    function isValidInitialWallet(data) {
      return (!('wallet' in data) || (
               data.wallet is map &&
               data.wallet.get('deposit', 0) is number && data.wallet.get('deposit', 0) == 0 &&
               data.wallet.get('winnings', 0) is number && data.wallet.get('winnings', 0) == 0 &&
               data.wallet.get('bonus', 0) is number && data.wallet.get('bonus', 0) == 0
             )) &&
             (!('walletBalance' in data) || (data.walletBalance is number && data.walletBalance == 0)) &&
             (!('winnings' in data) || (data.winnings is number && data.winnings == 0)) &&
             (!('bonus' in data) || (data.bonus is number && data.bonus == 0));
    }

    function isValidInitialStats(data) {
      return !('stats' in data) || (
        data.stats is map &&
        data.stats.get('matchesPlayed', 0) is number && data.stats.get('matchesPlayed', 0) == 0 &&
        data.stats.get('totalWins', 0) is number && data.stats.get('totalWins', 0) == 0 &&
        data.stats.get('totalKills', 0) is number && data.stats.get('totalKills', 0) == 0 &&
        data.stats.get('totalWinnings', 0) is number && data.stats.get('totalWinnings', 0) == 0
      );
    }

    function userTotalBalance(uData) {
      return ('wallet' in uData && uData.wallet is map)
        ? (uData.wallet.get('deposit', 0) + uData.wallet.get('winnings', 0) + uData.wallet.get('bonus', 0))
        : (uData.get('walletBalance', 0) + uData.get('winnings', 0) + uData.get('bonus', 0));
    }

    function userWinningsBalance(uData) {
      return ('wallet' in uData && uData.wallet is map)
        ? uData.wallet.get('winnings', 0)
        : uData.get('winnings', 0);
    }

    function isValidUserCreate(data) {
      return data.keys().hasAll(['username', 'email']) &&
             data.keys().hasOnly([
               'username', 'email', 'phone', 'ign', 'gameIGNs', 'wallet',
               'isKycVerified', 'isAdmin', 'isBanned', 'stats', 'referredBy',
               'referralClaimed', 'deviceId', 'fcmEnabled', 'notificationsEnabled',
               'createdAt', 'walletBalance', 'winnings', 'bonus'
             ]) &&
             data.username is string && data.username.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 30)) &&
             (!('ign' in data) || data.ign == null || (data.ign is string && data.ign.size() <= 100)) &&
             (!('referredBy' in data) || data.referredBy == null || (data.referredBy is string && data.referredBy.size() <= 100)) &&
             (!('deviceId' in data) || data.deviceId == null || (data.deviceId is string && data.deviceId.size() <= 128)) &&
             (!('wallet' in data) || data.wallet is map) &&
             (!('walletBalance' in data) || data.walletBalance is number);
    }

    function isValidUserUpdate(data) {
      return (!('username' in data) || (data.username is string && data.username.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 30)) &&
             (!('ign' in data) || data.ign == null || (data.ign is string && data.ign.size() <= 100)) &&
             (!('gameIGNs' in data) || data.gameIGNs is map) &&
             (!('fcmEnabled' in data) || data.fcmEnabled is bool) &&
             (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
             (!('referralClaimed' in data) || data.referralClaimed is bool) &&
             (!('deviceId' in data) || data.deviceId == null || (data.deviceId is string && data.deviceId.size() <= 128)) &&
             (!('wallet' in data) || data.wallet is map);
    }

    function isValidOwnerWalletUpdate(existingData, incomingData) {
      return !incomingData.diff(existingData).affectedKeys().hasAny(['wallet']) || (
        !('wallet' in existingData) ? (
          incomingData.wallet is map &&
          incomingData.wallet.get('deposit', 0) is number && incomingData.wallet.get('deposit', 0) >= 0 &&
          incomingData.wallet.get('deposit', 0) <= existingData.get('walletBalance', 0) &&
          incomingData.wallet.get('winnings', 0) is number && incomingData.wallet.get('winnings', 0) >= 0 &&
          incomingData.wallet.get('winnings', 0) <= existingData.get('winnings', 0) &&
          incomingData.wallet.get('bonus', 0) is number && incomingData.wallet.get('bonus', 0) >= 0 &&
          incomingData.wallet.get('bonus', 0) <= existingData.get('bonus', 0)
        ) : (
          incomingData.wallet is map &&
          incomingData.wallet.get('deposit', 0) is number && incomingData.wallet.get('deposit', 0) >= 0 &&
          incomingData.wallet.get('deposit', 0) <= existingData.wallet.get('deposit', 0) &&
          incomingData.wallet.get('winnings', 0) is number && incomingData.wallet.get('winnings', 0) >= 0 &&
          incomingData.wallet.get('winnings', 0) <= existingData.wallet.get('winnings', 0) &&
          incomingData.wallet.get('bonus', 0) is number && incomingData.wallet.get('bonus', 0) >= 0 && (
            incomingData.wallet.get('bonus', 0) <= existingData.wallet.get('bonus', 0) || (
              existingData.get('referralClaimed', false) == false &&
              incomingData.get('referralClaimed', false) == true &&
              incomingData.wallet.get('bonus', 0) <= existingData.wallet.get('bonus', 0) + 10
            )
          )
        )
      );
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['tournamentId', 'userId', 'ign']) &&
             data.keys().hasOnly([
               'tournamentId', 'userId', 'ign', 'slot', 'slots',
               'teamMembers', 'totalSlotsBooked', 'gameId', 'status', 'joinedAt'
             ]) &&
             data.tournamentId is string && isValidId(data.tournamentId) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.ign is string && data.ign.size() >= 1 && data.ign.size() <= 100 &&
             (!('slots' in data) || (data.slots is list && data.slots.size() >= 1 && data.slots.size() <= 4)) &&
             (!('totalSlotsBooked' in data) || (data.totalSlotsBooked is number && data.totalSlotsBooked >= 1 && data.totalSlotsBooked <= 4)) &&
             (!('slots' in data) || !('totalSlotsBooked' in data) || data.slots.size() == data.totalSlotsBooked) &&
             (!('teamMembers' in data) || (data.teamMembers is list && data.teamMembers.size() >= 1 && data.teamMembers.size() <= 4)) &&
             (!('gameId' in data) || (data.gameId is string && data.gameId.size() <= 64)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 30));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'status']) &&
             data.keys().hasOnly([
               'userId', 'type', 'amount', 'status', 'matchId', 'title',
               'paymentMethod', 'upiId', 'utrNumber', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.type is string && data.type.size() <= 30 &&
             data.amount is number && data.amount >= 0 &&
             data.status is string && data.status.size() <= 30 &&
             (!('matchId' in data) || (data.matchId is string && data.matchId.size() <= 128)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 64)) &&
             (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 128)) &&
             (!('utrNumber' in data) || (data.utrNumber is string && data.utrNumber.size() <= 64));
    }

    // --- Specific Collection Rules ---

    // Admins: Trusted role mappings
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // Staff: Trusted match-staff role mappings
    match /staff/{staffId} {
      allow get: if isSignedIn() && isValidId(staffId) && (request.auth.uid == staffId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // Game Modes: Dynamic game mode configurations
    match /gameModes/{modeId} {
      allow get: if isSignedIn() && isValidId(modeId);
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(modeId) && isValidGameMode(incoming());
      allow delete: if isAdmin() && isValidId(modeId);
    }

    // Users: Profiles and wallet information
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserCreate(incoming()) && (
        isAdmin() || (
          (!('isAdmin' in incoming()) || incoming().isAdmin == false) &&
          (!('isKycVerified' in incoming()) || incoming().isKycVerified == false) &&
          (!('isBanned' in incoming()) || incoming().isBanned == false) &&
          (!('referralClaimed' in incoming()) || incoming().referralClaimed == false) &&
          isValidInitialWallet(incoming()) &&
          isValidInitialStats(incoming())
        )
      );
      allow update: if isSignedIn() && isValidId(userId) && isValidUserUpdate(incoming()) && (
        isAdmin() ||
        (isStaff() && isValidStaffResultUserUpdate(existing(), incoming())) || (
          isOwner(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'username', 'phone', 'ign', 'gameIGNs', 'wallet',
            'referralClaimed', 'deviceId', 'fcmEnabled', 'notificationsEnabled'
          ]) &&
          (!('referralClaimed' in incoming()) || existing().get('referralClaimed', false) == false || incoming().referralClaimed == true) &&
          isValidOwnerWalletUpdate(existing(), incoming())
        )
      );
    }

    // Games: Supported games
    match /games/{gameId} {
      allow get: if isSignedIn() && isValidId(gameId);
      allow list: if isSignedIn();
      allow write: if isAdmin() && isValidId(gameId);
    }

    // Game Rules: Detailed rules for game modes
    match /gameRules/{ruleId} {
      allow get: if isSignedIn() && isValidId(ruleId);
      allow list: if isSignedIn();
      allow write: if isAdmin() && isValidId(ruleId);
    }

    // Matches: Tournament/match instances (public/joined overview without private IDP)
    match /matches/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId);
      allow list: if isSignedIn();
      allow create: if (isAdmin() || isStaff()) && isValidId(matchId);
      allow delete: if isAdmin() && isValidId(matchId);
      allow update: if isSignedIn() && isValidId(matchId) && (
        isAdmin() || isStaff() || (
          existing().get('status', 'upcoming') in ['upcoming', 'active'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['players', 'playersCount']) &&
          incoming().players is list &&
          existing().get('players', []) is list &&
          incoming().players.size() > existing().get('players', []).size() &&
          incoming().players.hasAll(existing().get('players', [])) &&
          incoming().playersCount is number &&
          incoming().playersCount > existing().get('playersCount', 0) &&
          incoming().playersCount <= incoming().get('totalSlots', incoming().get('maxPlayers', 100)) &&
          (incoming().players.size() - existing().get('players', []).size()) == (incoming().playersCount - existing().get('playersCount', 0)) &&
          existsAfter(/databases/$(database)/documents/registrations/$(matchId + '_' + request.auth.uid)) &&
          (incoming().players.size() - existing().get('players', []).size()) == getAfter(/databases/$(database)/documents/registrations/$(matchId + '_' + request.auth.uid)).data.get('totalSlotsBooked', 1)
        )
      );
    }

    // Match Credentials: Private Room ID & Password ONLY for admins, staff, and joined players
    match /matchCredentials/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId) && (
        isAdmin() ||
        isStaff() ||
        exists(/databases/$(database)/documents/registrations/$(matchId + '_' + request.auth.uid))
      );
      allow list: if isAdmin() || isStaff();
      allow create, update: if (isAdmin() || isStaff()) && isValidId(matchId) && isValidMatchCredential(incoming());
      allow delete: if (isAdmin() || isStaff()) && isValidId(matchId);
    }

    // Registrations: Player entries into matches
    match /registrations/{registrationId} {
      allow get: if isSignedIn() && isValidId(registrationId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(registrationId) && isValidRegistration(incoming()) && (
        isAdmin() || (
          incoming().userId == request.auth.uid &&
          registrationId == incoming().tournamentId + '_' + request.auth.uid &&
          incoming().get('status', 'active') == 'active' &&
          exists(/databases/$(database)/documents/matches/$(incoming().tournamentId)) &&
          get(/databases/$(database)/documents/matches/$(incoming().tournamentId)).data.get('status', 'upcoming') in ['upcoming', 'active'] &&
          existsAfter(/databases/$(database)/documents/matches/$(incoming().tournamentId)) &&
          (
            get(/databases/$(database)/documents/matches/$(incoming().tournamentId)).data.get('entryFee', 0) <= 0 ||
            userTotalBalance(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data) <=
              userTotalBalance(get(/databases/$(database)/documents/users/$(request.auth.uid)).data) -
              (get(/databases/$(database)/documents/matches/$(incoming().tournamentId)).data.get('entryFee', 0) * incoming().get('totalSlotsBooked', 1)) + 0.05
          )
        )
      );
      allow update: if isAdmin() && isValidId(registrationId) && isValidRegistration(incoming());
      allow delete: if isAdmin() && isValidId(registrationId);
    }

    // Transactions: Financial audit trail (Strict creation & immutable history)
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        isAdmin() ||
        existing().userId == request.auth.uid ||
        existing().type == 'win'
      );
      allow create: if isSignedIn() && isValidId(transactionId) &&
                       isValidTransaction(incoming()) && (
                         isAdmin() ||
                         (
                           isStaff() &&
                           incoming().type == 'win' &&
                           incoming().status == 'completed' &&
                           incoming().amount > 0 &&
                           incoming().amount <= 50000
                         ) || (
                           incoming().userId == request.auth.uid &&
                           incoming().amount > 0 && incoming().amount <= 50000 &&
                           (
                             (incoming().type == 'deposit' && incoming().status == 'pending' && incoming().amount >= 10) ||
                             (
                               incoming().type in ['withdraw', 'withdrawal'] &&
                               incoming().status == 'pending' &&
                               incoming().amount >= 100 &&
                               userWinningsBalance(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data) <=
                                 userWinningsBalance(get(/databases/$(database)/documents/users/$(request.auth.uid)).data) - incoming().amount + 0.05
                             ) ||
                             (
                               incoming().type == 'entry' &&
                               incoming().status == 'completed' &&
                               'matchId' in incoming() &&
                               incoming().matchId is string &&
                               isValidId(incoming().matchId) &&
                               existsAfter(/databases/$(database)/documents/registrations/$(incoming().matchId + '_' + request.auth.uid))
                             ) ||
                             (
                               incoming().type == 'bonus' &&
                               incoming().status == 'completed' &&
                               incoming().amount <= 10 &&
                               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('referralClaimed', false) == false &&
                               getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('referralClaimed', false) == true
                             )
                           )
                         )
                       );
      allow update: if isAdmin() && isValidId(transactionId) && isValidTransaction(incoming());
      allow delete: if false;
    }

    // App Settings: Global configs
    match /appSettings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId);
      allow list: if isSignedIn();
      allow write: if isAdmin() && isValidId(settingId);
    }

    // Banners: Promotional banners
    match /banners/{bannerId} {
      allow get: if isSignedIn() && isValidId(bannerId);
      allow list: if isSignedIn();
      allow write: if isAdmin() && isValidId(bannerId);
    }

    // Match Results: Declared winners and scores (public to signed-in players)
    match /matchResults/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId);
      allow list: if isSignedIn();
      allow write: if (isAdmin() || isStaff()) && isValidId(matchId);
    }

    // Payment Settings: Gateway configurations & API secrets (Admin only)
    match /paymentSettings/{gatewayId} {
      allow get, write: if isAdmin() && isValidId(gatewayId);
      allow list: if isAdmin();
    }

    // Notifications: Push alerts & broadcast messages
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId);
      allow list: if isSignedIn();
      allow create, delete: if (isAdmin() || isStaff()) && isValidId(notificationId);
      allow update: if isSignedIn() && isValidId(notificationId) && (
        isAdmin() || isStaff() || (
          incoming().diff(existing()).affectedKeys().hasOnly(['readBy']) &&
          incoming().readBy is list &&
          incoming().readBy.size() <= 10000 &&
          incoming().readBy.hasAll(existing().get('readBy', [])) &&
          request.auth.uid in incoming().readBy
        )
      );
    }

    // Legacy/Mirror support for tournaments
    match /tournaments/{tournamentId} {
      allow get: if isSignedIn() && isValidId(tournamentId);
      allow list: if isSignedIn();
      allow write: if isAdmin() && isValidId(tournamentId);
    }

    // Meta/Counters
    match /meta/counters {
      allow read, get, write: if isAdmin() || isStaff();
    }
  }
}
