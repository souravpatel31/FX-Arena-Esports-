{
  "version": 2,
  "rewrites": [
    {
      "source": "/((?!api/|robots\\.txt$|sitemap\\.xml$|manifest\\.json$|sw\\.js$|assets/).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "{firebase-applet-config.json,lib/**,api/**}"
    }
  }
}
